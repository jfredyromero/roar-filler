{
    "manifest_version": 3,
    "name": "rOar Filler",
    "version": "1.0.0",
    "description": "Automatically fills 8 daily hours in the rOar timesheet.",
    "permissions": ["scripting", "activeTab", "tabs", "storage"],
    "host_permissions": [
      "https://roar.marcel.ai/*",
      "https://roar-api.marcel.ai/*"
    ],
    "action": {
      "default_popup": "index.html",
      "default_title": "rOar Filler",
      "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }